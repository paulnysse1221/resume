<style>
  :root{
    --bg: #0B1220;
    --surface: #121B2E;
    --surface-2: #182338;
    --line: #253253;
    --text: #E7ECF5;
    --text-dim: #93A0BD;
    --accent: #F2A340;
    --accent-dim: #7A5B2C;
    --good: #4ADE80;
    --display: 'Space Grotesk', sans-serif;
    --body: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--body);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
  a{color:inherit;}
  .wrap{max-width:1040px; margin:0 auto; padding:0 28px;}

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(11,18,32,0.85);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between; padding:16px 28px;}
  .nav-name{font-family:var(--display); font-weight:600; font-size:16px; letter-spacing:0.02em;}
  .nav-links{display:flex; gap:28px; font-size:14px; color:var(--text-dim);}
  .nav-links a{text-decoration:none; transition:color .2s;}
  .nav-links a:hover{color:var(--accent);}
  .nav-links a:focus-visible, a:focus-visible{outline:2px solid var(--accent); outline-offset:3px;}
  .nav-cta{
    font-size:13px; font-family:var(--mono); color:var(--bg); background:var(--accent);
    padding:8px 14px; border-radius:4px; text-decoration:none; font-weight:500;
  }
  @media (max-width: 640px){ .nav-links{display:none;} }

  /* HERO */
  header.hero{padding:88px 0 64px; position:relative; overflow:hidden;}
  .eyebrow{
    font-family:var(--mono); font-size:12.5px; color:var(--accent);
    letter-spacing:0.12em; text-transform:uppercase; margin-bottom:20px;
    display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{content:''; width:20px; height:1px; background:var(--accent);}
  h1{
    font-family:var(--display); font-weight:700;
    font-size:clamp(36px, 6vw, 64px); line-height:1.04; letter-spacing:-0.01em;
    max-width:820px;
  }
  h1 .accent{color:var(--accent);}
  .hero-sub{
    margin-top:22px; font-size:18px; color:var(--text-dim); max-width:600px; line-height:1.65;
  }
  .hero-meta{
    margin-top:28px; display:flex; flex-wrap:wrap; gap:20px; font-family:var(--mono); font-size:13px; color:var(--text-dim);
  }
  .hero-meta span{display:flex; align-items:center; gap:7px;}
  .dot{width:6px; height:6px; border-radius:50%; background:var(--good);}

  /* PIPELINE CHART - signature element */
  .chart-block{
    margin-top:56px; background:var(--surface); border:1px solid var(--line); border-radius:10px;
    padding:28px 28px 20px;
  }
  .chart-head{display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:6px;}
  .chart-title{font-family:var(--mono); font-size:12px; color:var(--text-dim); letter-spacing:0.05em; text-transform:uppercase;}
  .chart-figure{font-family:var(--display); font-size:15px; color:var(--good); font-weight:600;}
  svg#pipeline{width:100%; height:auto; display:block; overflow:visible;}
  .pipe-line{
    fill:none; stroke:var(--accent); stroke-width:2.5;
    stroke-dasharray:900; stroke-dashoffset:900;
    animation:draw 1.8s cubic-bezier(.4,0,.2,1) .3s forwards;
  }
  .pipe-area{opacity:0; animation:fadein 1.2s ease 1.6s forwards;}
  @keyframes draw{ to{stroke-dashoffset:0;} }
  @keyframes fadein{ to{opacity:1;} }
  .pipe-point{opacity:0; animation:fadein .5s ease forwards;}
  .pipe-label{font-family:var(--mono); font-size:11px; fill:var(--text-dim);}
  .pipe-value{font-family:var(--mono); font-size:13px; fill:var(--text); font-weight:500;}

  section{padding:64px 0; border-top:1px solid var(--line);}
  .section-head{display:flex; align-items:baseline; gap:14px; margin-bottom:36px;}
  .section-num{font-family:var(--mono); font-size:12px; color:var(--accent);}
  h2{font-family:var(--display); font-size:clamp(24px,3vw,32px); font-weight:600; letter-spacing:-0.01em;}

  /* SUMMARY */
  .summary-text{font-size:17px; color:var(--text-dim); max-width:760px; line-height:1.75;}
  .summary-text strong{color:var(--text); font-weight:600;}

  /* RESULTS GRID */
  .results-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:10px; overflow:hidden;}
  .result-card{background:var(--surface); padding:26px 22px;}
  .result-num{font-family:var(--display); font-size:30px; font-weight:700; color:var(--accent); line-height:1;}
  .result-label{margin-top:10px; font-size:13.5px; color:var(--text-dim); line-height:1.5;}
  .result-co{margin-top:12px; font-family:var(--mono); font-size:11.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.05em;}

  /* EXPERIENCE */
  .job{
    padding:28px 0; border-bottom:1px solid var(--line); display:grid; grid-template-columns:200px 1fr; gap:24px;
  }
  .job:last-child{border-bottom:none;}
  .job-meta{font-family:var(--mono); font-size:12.5px; color:var(--text-dim); padding-top:3px;}
  .job-meta .dates{display:block; margin-top:6px;}
  .job-title{font-family:var(--display); font-size:19px; font-weight:600;}
  .job-title .co{color:var(--accent);}
  .job ul{margin-top:14px; padding-left:18px; color:var(--text-dim); font-size:15px;}
  .job li{margin-bottom:9px; line-height:1.6;}
  .job li::marker{color:var(--accent);}
  @media (max-width:640px){ .job{grid-template-columns:1fr; gap:8px;} }

  /* SKILLS */
  .skills-wrap{display:flex; flex-wrap:wrap; gap:10px;}
  .skill-pill{
    font-family:var(--mono); font-size:13px; color:var(--text-dim);
    border:1px solid var(--line); padding:8px 14px; border-radius:20px;
    transition:border-color .2s, color .2s;
  }
  .skill-pill:hover{border-color:var(--accent); color:var(--text);}

  /* CONTACT */
  footer{padding:70px 0 60px; border-top:1px solid var(--line);}
  .contact-head{font-family:var(--display); font-size:clamp(26px,4vw,38px); font-weight:600; max-width:560px; line-height:1.15;}
  .contact-links{margin-top:30px; display:flex; flex-wrap:wrap; gap:16px;}
  .contact-link{
    display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:14px;
    padding:12px 18px; border:1px solid var(--line); border-radius:6px; text-decoration:none; color:var(--text);
    transition:border-color .2s, background .2s;
  }
  .contact-link:hover{border-color:var(--accent); background:var(--surface);}
  .contact-link:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  .foot-note{margin-top:46px; font-size:12.5px; color:var(--text-dim); font-family:var(--mono);}
</style>
</head>
